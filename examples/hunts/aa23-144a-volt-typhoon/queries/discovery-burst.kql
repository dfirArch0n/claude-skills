// Discovery burst: many different enumeration tools, one host, one account, a few minutes.
// Platform: Microsoft Defender XDR (advanced hunting). Not run against a live tenant.
//
// Why native and not Sigma: Sigma filters one event at a time. This counts how many
// DIFFERENT tools an account ran close together, which needs an aggregation Sigma cannot
// express. Every tool on the list is an ordinary admin binary; it is the burst that is
// unusual. The list is taken from the "Enumeration of the Environment" section of
// CISA AA23-144A.
//
// Windowing: fixed 10-minute bins would split a burst that straddles a boundary (12:09
// and 12:11 land in different bins). Each event is therefore counted in two bins offset by
// five minutes, so any burst that fits inside five minutes is always seen whole. A slower
// burst, up to ten minutes, may still be split; lower the threshold if that matters.
let discovery_tools = dynamic([
    "arp.exe", "dnscmd.exe", "ipconfig.exe", "ldifde.exe", "net.exe", "net1.exe",
    "netsh.exe", "netstat.exe", "nltest.exe", "reg.exe", "systeminfo.exe",
    "tasklist.exe", "wevtutil.exe", "whoami.exe", "wmic.exe"]);
DeviceProcessEvents
| where Timestamp > ago(30d)
| where FileName in~ (discovery_tools)
| extend Window = pack_array(bin(Timestamp, 10m), bin(Timestamp + 5m, 10m) - 5m)
| mv-expand Window to typeof(datetime)
| summarize ToolCount = dcount(FileName),
            Tools = make_set(FileName),
            Commands = make_set(ProcessCommandLine, 50)
    by DeviceName, AccountName, Window
| where ToolCount >= 5
| order by ToolCount desc
